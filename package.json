{
  "name": "react-native-charts-wrapper",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuxudong/react-native-charts-wrapper.git"
  },
  "version": "0.6.0",
  "description": "A react-native charts support both android and iOS.",
  "author": "wuxudong",
  "license": "MIT",
  "nativePackage": true,
  "homepage": "https://github.com/wuxudong/react-native-charts-wrapper",
  "keywords": [
    "react native",
    "chart",
    "android",
    "MPAndroidChart",
    "ios",
    "Charts"
  ],
  "files": [
    "android/src",
    "android/build.gradle",
    "android/gradle.properties",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.swift",
    "js",
    "index.js",
    "index.d.ts",
    "react-native-charts-wrapper.podspec",
    "ios/ReactNativeCharts/ReactNativeCharts.xcodeproj/project.pbxproj"
  ],
  "dependencies": {
    "react-native": ">=0.70.0"
  },
  "peerDependencies": {
    "react": ">=16.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.70.0",
    "typescript": "^4.9.5"
  },
  "packageManager": "yarn@3.6.4+sha256.7f7d51b38db0d94adf25c512e3f3d3b47d23c97922eecc540f7440f116bdb99a",
  "scripts": {
    "build": "tsc",
    "prepare": "yarn build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf lib/*.d.ts lib/*.js.map lib/*.js"
  },
  "codegenConfig": {
    "name": "ReactNativeChartsWrapperSpec",
    "type": "all",
    "jsSrcsDir": "js",
    "ios": {
      "libraryName": "ReactNativeChartsWrapper"
    }
  }
}
